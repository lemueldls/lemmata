---
// The landing, written as a proof: the plan is the premise, the font is the
// construction, the checksum is the proof, and the equations are the corollary.
//
// Every number on the page comes out of the font the page built, and the
// wordmark is set to the width of the measure in that font, on the grid it was
// drawn on.
//
// Stubs, and what they want. Grep for "Stub:" when one is finished.
//
//   Stub: spec.optical-sizes  the plan has no optical size key behind this row
//   Stub: spec.script-style   needs the script letters, and an ssty feature
//   Stub: texture.healing     the narrow letters have no shifted spelling, and
//                             `calt` needs a contextual lookup, which the layout
//                             crate does not write: every feature it builds is a
//                             single substitution. Until then the page moves the
//                             ink with margins. What must not move, the advance,
//                             does not.
//   Stub: variant.picker      the capture carries one spelling per glyph, so
//                             the picker sets the selection and reports it;
//                             wire it to the worker once a plan can name the
//                             variant it wants
//
// The samples are written in the characters the capture carries, which is the
// lowercase letters, the digits and some punctuation. The glyph sheet says the
// rest, since the sheet is read out of the font's own character map.
import Base from "../layouts/Base.astro";
import golden from "../../../golden/parity.json";
import corpus from "../../../corpus/equations.mathml?raw";

const base = import.meta.env.BASE_URL;

// The reference plan, which is what `Plan::default()` carries. It is content on
// this page the way the samples are: the premise the rest is built from, and the
// object the command line takes with `--plan`.
const plan = {
  capHeight: 735,
  xHeight: 520,
  ascender: 965,
  descender: -215,
  italicAngle: 0,
  weight: 400,
};

const samples = {
  code: `// one plan in, one font out
let metrics = plan.metrics()?;
let font = build(&glyphs, &metrics)?;`,
  prose: `the quick brown fox jumps over the lazy dog
five or six big planes flew quickly overhead
a silk purse from a sow's ear, and no small beer`,
  figures: `0123456789
+1234.5678 -90% #42 3/4 (2019)
i. ii. iii. iv. v. 1st 2nd 3rd 4th`,
};

// Stub: spec.optical-sizes, spec.script-style. Those rows describe work the page
// does not do yet, and are on the page the way the finished typeface will
// describe itself. Texture healing above them is demonstrated in the page rather
// than carried by the font, which `texture.healing` further down records.
const spec = [
  { name: "Metrics", note: "Every key in the plan reaches the font's tables." },
  { name: "Parameters", note: "The parameter tables, read as upstream writes them." },
  { name: "Variants", note: "Every letter in as many spellings as you care to compare." },
  { name: "Texture healing", note: "A narrow letter gives its sidebearings to a wide neighbour, and the cell stays where it was." },
  { name: "Math", note: "The constants, the italic corrections, and the delimiters that grow to fit." },
  { name: "Optical sizes", note: "A cut for footnotes and a cut for display, from one plan." },
  { name: "Script style", note: "Letters drawn for the size of the body they sit in." },
];

const variants = [
  "a",
  "a.doubleStoreySerifed",
  "a.singleStoreySerifless",
];
---

<Base title="A typeface built from a plan">
  <section class="hero">
    <div class="wrap">
      <p class="kicker">A premise, a construction, a proof</p>
      <div class="hero__stage">
        <div class="hero__grid" aria-hidden="true"></div>
        <h1 class="wordmark">lemmata<span class="probe" aria-hidden="true"></span></h1>
        <div class="rules" id="rules" hidden>
          <i class="rule rule--asc"><span>ascender <b id="rule-asc">…</b></span></i>
          <i class="rule rule--x"><span>x-height <b id="rule-x">…</b></span></i>
          <i class="rule rule--base"><span>baseline</span></i>
        </div>
      </div>
      <p class="lede">
        A lemma is a premise you build the rest on. Take the plan as given and
        this page builds the font: constructed here, measured here, and hashed
        so that it can be checked.
      </p>
      <div class="actions">
        <a class="btn" href="#construction">See the construction</a>
        <a class="btn btn--primary" href={`${base}generate/`}>Open the generator</a>
      </div>
      <p class="status" id="build-status" data-state="note">Reading the font…</p>
    </div>
  </section>

  <section class="section" id="premises">
    <div class="wrap section__grid">
      <p class="label">01 / Premises</p>
      <div class="section__body">
        <h2>Everything is built from the plan</h2>
        <p>
          The plan is the premise. Every key defaults, so this is the reference
          plan, and every key it carries reaches the font.
        </p>
        <div class="cols">
          <div class="panel">
            <div class="panel__head">
              <span>plan.json</span>
              <button class="chip" id="copy-plan" type="button">copy</button>
            </div>
            <pre class="code" id="plan-code">{JSON.stringify(plan, null, 2)}</pre>
          </div>
          <div class="panel">
            <div class="panel__head"><span>What the plan carries</span></div>
            <div class="panel__body ledger">
              {spec.map((row) => (
                <div class="ledger__row">
                  <span class="ledger__name">{row.name}</span>
                  <span class="ledger__note">{row.note}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="construction">
    <div class="wrap section__grid">
      <p class="label">02 / Construction</p>
      <div class="section__body">
        <h2>The font, set in itself</h2>
        <p>
          This is the font this page built, and every reading further down comes
          out of its own tables. Edit the sample and it stays the font.
        </p>
        <div class="panel">
          <div class="panel__head">
            <div class="tabs">
              <button class="tab" type="button" data-sample="code" aria-selected="true">code</button>
              <button class="tab" type="button" data-sample="prose">prose</button>
              <button class="tab" type="button" data-sample="figures">figures</button>
            </div>
            <label class="size">
              size
              <input id="size" type="range" min="12" max="52" step="1" value="22" />
              <b id="size-value">22</b>
            </label>
          </div>
          <textarea id="sample" class="sample" rows="6" spellcheck="false">{samples.code}</textarea>
          <div class="panel__foot">
            <p class="status" id="sample-status" data-state="note">Waiting for the build…</p>
            <button class="btn" id="present" type="button">Present</button>
          </div>
        </div>

        <div class="subhead">
          <h3>Texture healing</h3>
          <p class="note" id="heal-measure">Reading the font…</p>
        </div>
        <div class="panel">
          <div class="panel__body heal-lines" id="heal-lines">
            <div class="heal-line">
              <span class="heal-label">plain</span>
              <p class="heal-text" id="heal-plain"></p>
            </div>
            <div class="heal-line">
              <span class="heal-label">healed</span>
              <p class="heal-text" id="heal-healed"></p>
            </div>
          </div>
          <div class="panel__foot">
            <p class="note">
              A monospace cell is one width for every letter, so a narrow one
              leaves a gap beside a wide one. Healing moves the narrow letter's
              sidebearings to its wider neighbour and leaves the cell where it
              was, which is what the grid under both lines is for.
            </p>
          </div>
        </div>

        <div class="subhead">
          <h3>Spellings of a</h3>
          <p class="note">Pick one and the next build draws it.</p>
        </div>
        <div class="variants">
          {variants.map((name, index) => (
            <button
              class="variant"
              type="button"
              data-variant={name}
              aria-pressed={index === 0}
            >
              <b>a</b>
              <span>{name}</span>
            </button>
          ))}
        </div>
        <p class="status" id="variant-status" data-state="note">
          a · the spelling this build draws
        </p>

        <div class="subhead">
          <h3>Every character it carries</h3>
          <p class="note" id="glyph-count">Reading the font…</p>
        </div>
        <div class="glyphs" id="glyphs"></div>
      </div>
    </div>
  </section>

  <section class="section" id="proof">
    <div class="wrap section__grid">
      <p class="label">03 / Proof</p>
      <div class="section__body">
        <h2>The build proves itself</h2>
        <p>
          A font is hard to argue with and easy to check. The build hashes
          itself, and the number it produces is the number the reference build
          recorded, so the plan and the font meet at one digest. The readings
          beside it come from the tables, not from the page's memory of what it
          meant to do.
        </p>
        <div class="cols">
          <div class="panel">
            <div class="panel__head">
              <span>Checksums</span>
              <span class="chip" id="verdict" data-state="pending">hashing</span>
            </div>
            <div class="panel__body">
              <dl class="rows">
                <div class="rows__row">
                  <dt>capture</dt>
                  <dd id="sum-capture" data-hash={golden.capture} title={golden.capture}>
                    {golden.capture.slice(0, 16)}…
                  </dd>
                </div>
                <div class="rows__row">
                  <dt>built here</dt>
                  <dd id="sum-built">…</dd>
                </div>
                <div class="rows__row">
                  <dt>reference build</dt>
                  <dd id="sum-recorded" data-hash={golden.font} title={golden.font}>
                    {golden.font.slice(0, 16)}…
                  </dd>
                </div>
              </dl>
              <p class="note" id="parity-note">Waiting for the build.</p>
              <p class="note">
                rustc {golden.toolchain.rustc} · wasm-bindgen {golden.toolchain["wasm-bindgen"]} ·
                upstream {golden.upstream.slice(0, 7)}
              </p>
            </div>
          </div>
          <div class="panel">
            <div class="panel__head"><span>Read from the font</span></div>
            <div class="panel__body">
              <dl class="rows">
                <div class="rows__row"><dt>units per em</dt><dd id="measure-upem">…</dd></div>
                <div class="rows__row"><dt>glyphs drawn</dt><dd id="measure-glyphs">…</dd></div>
                <div class="rows__row"><dt>characters mapped</dt><dd id="measure-mapped">…</dd></div>
                <div class="rows__row"><dt>x-height, x</dt><dd id="measure-x">…</dd></div>
                <div class="rows__row"><dt>ascender, l</dt><dd id="measure-asc">…</dd></div>
                <div class="rows__row"><dt>descender, p</dt><dd id="measure-desc">…</dd></div>
                <div class="rows__row"><dt>advance, x</dt><dd id="measure-advance">…</dd></div>
              </dl>
              <p class="note">
                In font units, out of the tables of the font just built. The ink
                is the bounding box the outline carries.
              </p>
            </div>
          </div>
        </div>
        <p class="qed">Q.E.D.</p>
      </div>
    </div>
  </section>

  <section class="section" id="corollary">
    <div class="wrap section__grid">
      <p class="label">04 / Corollary</p>
      <div class="section__body">
        <h2>Equations follow</h2>
        <p>
          A MATH table comes out of the same construction: the constants, the
          italic corrections, and the delimiters that grow to fit. This one is
          set in a second face, built from the math glyph set when the section
          comes into view.
        </p>
        <div class="panel">
          <div class="panel__body">
            <div class="equation" id="equation"></div>
          </div>
          <div class="panel__foot">
            <p class="status" id="equation-status" data-state="note">
              Waiting for the section to come into view.
            </p>
            <a class="btn" href={`${base}math/`}>Set your own</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div hidden id="sample-prose">{samples.prose}</div>
  <div hidden id="sample-figures">{samples.figures}</div>
  <template id="corpus" set:html={corpus}></template>

  <div class="stage" id="stage" hidden tabindex="-1">
    <div class="stage__body">
      <p class="stage__sample" id="stage-sample"></p>
    </div>
    <p class="stage__hint">space · next sample &nbsp; esc · done</p>
  </div>

  <script>
    import {
      advance,
      cmap,
      coverage,
      glyphCount,
      ink,
      sha256Hex,
      short,
      unitsPerEm,
    } from "../lib/font.js";

    const $ = (selector) => document.querySelector(selector);
    const base = import.meta.env.BASE_URL;
    const say = (element, state, text) => {
      element.dataset.state = state;
      element.textContent = text;
    };
    const escape = (text) =>
      text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    // The samples are content, so the field already holds the first one.
    const sampleField = $("#sample");
    const samples = {
      code: sampleField.value,
      prose: $("#sample-prose").textContent,
      figures: $("#sample-figures").textContent,
    };

    let page = null;
    const sampleStatus = $("#sample-status");
    const updateCoverage = () => {
      if (!page) return;
      // The character map, not a measurement: a family that is missing a glyph
      // hands the character to a fallback, and the fallback's numbers would pass
      // for the font's.
      const { total, missing } = coverage(page.map, sampleField.value);
      say(
        sampleStatus,
        missing.length ? "note" : "ok",
        missing.length
          ? `${total - missing.length} of ${total} characters in this sample are in the font · missing ${missing.join(" ")}`
          : `all ${total} characters in this sample are in the font`,
      );
    };

    for (const tab of document.querySelectorAll(".tab")) {
      tab.addEventListener("click", () => {
        for (const other of document.querySelectorAll(".tab")) {
          other.setAttribute("aria-selected", String(other === tab));
        }
        sampleField.value = samples[tab.dataset.sample];
        updateCoverage();
        $("#stage-sample").textContent = sampleField.value;
      });
    }

    // Presenting puts one sample the width of the screen and takes the rest of
    // the page away. Space moves to the next sample, which is the same move as
    // clicking the next tab.
    const stage = $("#stage");
    const openStage = () => {
      stage.hidden = false;
      document.body.style.overflow = "hidden";
      $("#stage-sample").textContent = sampleField.value;
      // Focus leaves the button, so space advances the sample instead of
      // pressing the button that opened this.
      stage.focus();
    };
    const closeStage = () => {
      stage.hidden = true;
      document.body.style.overflow = "";
    };
    const nextSample = () => {
      const tabs = [...document.querySelectorAll(".tab")];
      const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
      tabs[(current + 1) % tabs.length].click();
    };

    // A toggle, because the keyboard reaches it through `#present`: the shell
    // clicks that button for `p`, and a button that only opens cannot close.
    $("#present").addEventListener("click", () => {
      if (stage.hidden) openStage();
      else closeStage();
    });
    stage.addEventListener("click", nextSample);
    addEventListener("keydown", (event) => {
      if (stage.hidden) return;
      if (event.key === "Escape") closeStage();
      if (event.key === " ") {
        event.preventDefault();
        nextSample();
      }
    });

    const size = $("#size");
    const applySize = () => {
      sampleField.style.fontSize = `${size.value}px`;
      $("#size-value").textContent = size.value;
    };
    size.addEventListener("input", applySize);
    applySize();
    sampleField.addEventListener("input", updateCoverage);

    // Stub: variant.picker. The capture carries one spelling per glyph, so the
    // choice is kept and reported rather than built. When a plan can name the
    // variant, this should post the plan to the worker and swap the specimen.
    const variantStatus = $("#variant-status");
    for (const button of document.querySelectorAll(".variant")) {
      button.addEventListener("click", () => {
        for (const other of document.querySelectorAll(".variant")) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        say(variantStatus, "ok", `${button.dataset.variant} · the spelling this build draws`);
      });
    }

    // Texture healing, demonstrated with margins.
    //
    // Stub: texture.healing. A font that carries this has a second spelling of
    // each narrow letter, shifted in its sidebearings, and a `calt` feature that
    // swaps it in beside a wide neighbour. The spellings are a translation of
    // the captured outlines rather than new drawing, the way the dotless forms
    // are, but `calt` needs a contextual lookup and every feature
    // `lemmata-layout` builds today is a single substitution. Margins are enough
    // to show the effect, and the one thing that must not move does not: the
    // advance, so the cell stays.
    const HEAL_SAMPLE = "millim minimum willow filial";
    const narrow = new Set("iltfjr");
    const wide = new Set("mw");
    const heal = (text) =>
      [...text]
        .map((character, index) => {
          const before = wide.has(text[index - 1] ?? "");
          const after = wide.has(text[index + 1] ?? "");
          if (!narrow.has(character) || (!before && !after)) {
            return escape(character);
          }

          return `<span class="heal" data-side="${after ? "right" : "left"}">${escape(character)}</span>`;
        })
        .join("");

    const plainLine = $("#heal-plain");
    const healedLine = $("#heal-healed");
    plainLine.textContent = HEAL_SAMPLE;
    healedLine.innerHTML = heal(HEAL_SAMPLE);

    // The wordmark is set to the width of the measure, in the font it ships, so
    // the grid behind it is the grid the letters sit on. The rules label their
    // own lines at the right end of the measure, so the column they need is
    // taken off first.
    const fit = () => {
      const word = $(".wordmark");
      const stage = $(".hero__stage");
      if (!stage.clientWidth) return 0;
      word.style.fontSize = "100px";
      const range = document.createRange();
      range.selectNode(word.firstChild);
      const width = range.getBoundingClientRect().width;
      if (!width) return 0;
      const room = Math.max(stage.clientWidth - 132, stage.clientWidth * 0.55);
      const points = Math.min((100 * room) / width, 340);
      word.style.fontSize = `${points}px`;

      return points;
    };

    // The rules are the font's own numbers, drawn where they sit in the
    // wordmark. The baseline comes from a probe sitting on it rather than from
    // the ascent and the half-leading.
    const drawRules = (metrics, points) => {
      const stage = $(".hero__stage");
      // On a narrow screen the wordmark fills the measure and the labels would
      // sit on the letters, so the rules go away rather than lie across them.
      if (stage.clientWidth < 520) {
        $("#rules").hidden = true;

        return;
      }
      const scale = points / 1000;
      const baseline =
        $(".probe").getBoundingClientRect().bottom -
        stage.getBoundingClientRect().top;
      const place = (selector, top) => { $(selector).style.top = `${top}px`; };

      place(".rule--asc", baseline - metrics.ascender * scale);
      place(".rule--x", baseline - metrics.xHeight * scale);
      place(".rule--base", baseline);
      $("#rule-asc").textContent = metrics.ascender;
      $("#rule-x").textContent = metrics.xHeight;
      $("#rules").hidden = false;

      // A cell is one advance plus the tracking the wordmark is set with, which
      // is negative here. Leaving the tracking out is what put the grid out of
      // step with the letters, by a little per cell and a lot by the last one.
      const tracking =
        Number.parseFloat(getComputedStyle($(".wordmark")).letterSpacing) || 0;
      const cell = (metrics.advance / 1000) * points + tracking;
      stage.style.setProperty("--cell", `${cell}px`);
    };

    // The sheet is the font's own character map, in code point order, drawn in
    // the font it came from.
    const sheet = (map) => {
      $("#glyphs").innerHTML = [...map.keys()]
        .sort((left, right) => left - right)
        .map((code) => {
          const character = String.fromCodePoint(code);
          const label = `U+${code.toString(16).toUpperCase().padStart(4, "0")}`;

          return code === 0x20
            ? `<figure class="glyph glyph--blank"><i aria-label="space"></i><figcaption>${label}</figcaption></figure>`
            : `<figure class="glyph"><i>${escape(character)}</i><figcaption>${label}</figcaption></figure>`;
        })
        .join("");
    };

    const status = $("#build-status");
    const planCode = $("#plan-code");
    const builtRow = $("#sum-built");
    const recordedRow = $("#sum-recorded");
    const verdict = $("#verdict");

    // The plan is rendered into the page, so the copy button takes it from the
    // element rather than from a builder that had to be asked for it.
    const planText = planCode.textContent;
    const copy = $("#copy-plan");
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(planText);
        copy.textContent = "copied";
      } catch {
        copy.textContent = "select it";
      }
      setTimeout(() => { copy.textContent = "copy"; }, 1400);
    });

    planCode.innerHTML = [
      "{",
      ...Object.entries(JSON.parse(planText)).map(
        ([key, value]) =>
          `  <span class="k">"${key}"</span>: <span class="n">${value}</span>`,
      ),
      "}",
    ].join(",\n").replace(",\n}", "\n}");

    try {
      // The file the page is set in, taken from the preload link so this is the
      // request the browser already made: the bytes hashed here are the bytes
      // being rendered with.
      const href =
        [...document.querySelectorAll("link[rel=preload]")]
          .map((link) => link.getAttribute("href"))
          .find((value) => value?.endsWith(".ttf")) ?? `${base}fonts/lemmata.ttf`;
      const bytes = new Uint8Array(
        await (await fetch(href)).arrayBuffer(),
      );
      const digest = await sha256Hex(bytes);
      const matches = digest === recordedRow.dataset.hash;
      const drawn = glyphCount(bytes) ?? 0;

      builtRow.textContent = short(digest);
      builtRow.title = digest;
      verdict.textContent = matches ? "byte-identical" : "differs";
      verdict.dataset.state = matches ? "ok" : "bad";
      $("#parity-note").textContent = matches
        ? "the font this page is set in matches the reference build"
        : "the font this page is set in differs from the reference build";
      say(
        status,
        matches ? "ok" : "bad",
        `${drawn.toLocaleString()} glyphs · ${bytes.length.toLocaleString()} bytes · ` +
          `sha256 ${short(digest, 12)}`,
      );

      // The primary family only. The list Astro emits carries an optimized
      // fallback face beside it, and asking for the list loads both: the
      // fallback is a local family that may not be installed, and one failed
      // face is enough to reject the whole request even though this one loaded.
      const primary = getComputedStyle(sampleField).fontFamily
        .split(",")[0]
        .trim();
      await document.fonts.load(`100px ${primary}`, "lemmata");

      const map = cmap(bytes);
      const metrics = {
        upem: unitsPerEm(bytes),
        drawn,
        mapped: map.size,
        xHeight: ink(map, bytes, "x")?.yMax ?? null,
        ascender: ink(map, bytes, "l")?.yMax ?? null,
        descender: ink(map, bytes, "p")?.yMin ?? null,
        advance: advance(map, bytes, "x"),
      };
      const rows = {
        "#measure-upem": metrics.upem,
        "#measure-glyphs": metrics.drawn,
        "#measure-mapped": metrics.mapped,
        "#measure-x": metrics.xHeight,
        "#measure-asc": metrics.ascender,
        "#measure-desc": metrics.descender,
        "#measure-advance": metrics.advance,
      };
      for (const [selector, value] of Object.entries(rows)) {
        $(selector).textContent =
          value === null || value === undefined ? "not in the font" : `${value}`;
      }

      page = { map, metrics };
      applySize();
      updateCoverage();
      sheet(map);
      $("#glyph-count").textContent =
        `${map.size} characters · ${drawn} glyphs drawn`;

      // The healing block is on the same grid as the hero, at the size that
      // block is set in, and the count is the number of characters: one cell
      // each, before and after the ink moves.
      const healGrid = () => {
        const size = Number.parseFloat(
          getComputedStyle($(".heal-text")).fontSize,
        );
        const cell = (metrics.advance / 1000) * size;
        $("#heal-lines").style.setProperty("--cell", `${cell}px`);
        $("#heal-measure").textContent =
          `${HEAL_SAMPLE.length} cells of ${Math.round(cell)} px, either line`;
      };
      healGrid();

      const points = fit();
      if (points) drawRules(metrics, points);
      addEventListener("resize", () => {
        const next = fit();
        if (next) drawRules(metrics, next);
        healGrid();
      });
    } catch (error) {
      say(status, "bad", `The font could not be read: ${error.message ?? error}`);
    }

    // The math face is a second font, and one section shows it, so it is asked
    // for when that section is a screen away. The stylesheet only reaches for
    // the family once the attribute is set, which is what keeps the download
    // out of the way until then.
    const equationStatus = $("#equation-status");
    const observer = new IntersectionObserver(async (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      try {
        say(equationStatus, "note", "Setting the equation…");
        // Using the family is what asks for the file, so the attribute goes on
        // first and the load is asked for by the name the element resolves to.
        const holder = $("#equation");
        holder.dataset.face = "ready";
        const primary = getComputedStyle(holder).fontFamily.split(",")[0].trim();
        await document.fonts.load(`24px ${primary}`, "\u222B");

        // The corpus sits in a template, and the template's contents are
        // already parsed: taking the equation from there skips a second parse
        // and the import that came with it.
        const equations = [...$("#corpus").content.querySelectorAll("math")];
        if (equations.length === 0) {
          throw new Error("the corpus in the page carries no equations");
        }
        const pick =
          equations.find((node) => node.textContent.includes("\u222B")) ??
          equations[0];
        holder.append(pick);
        say(
          equationStatus,
          "ok",
          `Ready. ${equations.length} in the corpus, this one set in the font built from the math glyph set.`,
        );
      } catch (error) {
        say(equationStatus, "bad", `The math face failed: ${error.message ?? error}`);
      }
    }, { rootMargin: "300px" });
    observer.observe($("#corollary"));
  </script>
</Base>
