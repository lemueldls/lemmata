---
// One shell for the site. The styles are inline because the site is small and a
// stylesheet would be a second thing to serve.
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Lemmata</title>
    <style is:global>
      :root { color-scheme: light dark; }
      body {
        margin: 0 auto; max-width: 46rem; padding: 3rem 1.5rem;
        font: 16px/1.65 ui-sans-serif, system-ui, sans-serif;
      }
      h1 { font-size: 1.7rem; margin-bottom: 0.25rem; }
      a { color: inherit; }
      nav a { margin-right: 1rem; }
      p, li { color: color-mix(in oklab, currentColor 78%, transparent); }
      code, pre, textarea { font-family: ui-monospace, monospace; }
      textarea, pre {
        width: 100%; box-sizing: border-box; padding: 0.75rem 1rem;
        border-radius: 0.4rem; background: transparent; color: inherit;
        border: 1px solid color-mix(in oklab, currentColor 25%, transparent);
      }
      textarea { resize: vertical; font-size: 13px; }
      button {
        font: inherit; padding: 0.5rem 1rem; border-radius: 0.4rem;
        border: 1px solid currentColor; background: transparent;
        color: inherit; cursor: pointer;
      }
      button[disabled] { opacity: 0.5; cursor: progress; }
      .row { display: flex; gap: 1rem; align-items: center; }
      .specimen { font-family: Lemmata; font-size: 28px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <nav>
      <a href={base}>Lemmata</a>
      <a href={`${base}generate/`}>Generate</a>
      <a href={`${base}math/`}>Equations</a>
    </nav>
    <slot />
  </body>
</html>
