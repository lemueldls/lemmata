---
// One shell for the site: the head, the masthead, the footer, the theme, the
// keyboard and the cover a page puts up while it builds its font.
//
// The theme is decided by an inline script before the stylesheet applies. A
// swap after paint shows the other theme for a frame, which is the one thing a
// toggle cannot fix afterwards.
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  /// Cover the page until it has a font to show. For the pages that build one
  /// on load.
  boot?: boolean;
}

const {
  title,
  description = "A typeface built from a plan, and proved in the page that shows it.",
  boot = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const on = (route: string) =>
  Astro.url.pathname.replace(base, "").startsWith(route) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Lemmata</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <script is:inline>
      const stored = localStorage.getItem("lemmata:theme");
      const system = matchMedia("(prefers-color-scheme: light)").matches
        ? "light"
        : "dark";
      document.documentElement.dataset.theme = stored ?? system;
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="brand" href={base}>Lemmata</a>
        <nav>
          <a href={`${base}generate/`} aria-current={on("generate")}>Generator</a>
          <a href={`${base}math/`} aria-current={on("math")}>Equations</a>
        </nav>
        <div class="masthead__right">
          <span class="tag" title="The Iosevka release the glyph definitions come from">
            Iosevka 34.9.0
          </span>
          <button class="chip" id="theme" type="button" title="Switch the theme (t)">
            theme
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer__grid">
        <div>
          <h3>Lemmata</h3>
          <p>A typeface built from a plan, and proved in the page that shows it.</p>
        </div>
        <div>
          <h3>Routes</h3>
          <ul>
            <li><a href={base}>Premises</a></li>
            <li><a href={`${base}generate/`}>Generator</a></li>
            <li><a href={`${base}math/`}>Equations</a></li>
          </ul>
        </div>
        <div>
          <h3>Keys</h3>
          <ul>
            <li><kbd>g</kbd> generator</li>
            <li><kbd>e</kbd> equations</li>
            <li><kbd>p</kbd> present</li>
            <li><kbd>t</kbd> theme</li>
          </ul>
        </div>
        <div>
          <h3>Provenance</h3>
          <ul>
            <li>Glyph definitions: Iosevka 34.9.0, OFL</li>
            <li>Everything else: MIT OR Apache-2.0</li>
            <li>Nothing is uploaded. There is no server to upload to.</li>
          </ul>
        </div>
      </div>
    </footer>
    {
      boot && (
        <div class="boot" id="boot" aria-hidden="true">
          <div class="boot__meter">
            <span class="boot__ticks" />
            <span class="boot__track">
              <i />
            </span>
          </div>
        </div>
      )
    }
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector("#theme");

      const paint = () => {
        toggle.textContent = `theme ${root.dataset.theme}`;
      };

      const flip = () => {
        root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
        localStorage.setItem("lemmata:theme", root.dataset.theme);
        paint();
      };

      paint();
      toggle.addEventListener("click", flip);

      // The cover comes down when the page says it is ready to be looked at,
      // and it comes down anyway after a while: a build that never finishes
      // must not leave the page behind a curtain.
      const boot = document.querySelector("#boot");
      if (boot) {
        const done = () => {
          boot.dataset.done = "";
          setTimeout(() => boot.remove(), 400);
        };
        if (root.dataset.boot === "done") {
          done();
        } else {
          const watch = new MutationObserver(() => {
            if (root.dataset.boot !== "done") return;
            watch.disconnect();
            done();
          });
          watch.observe(root, { attributes: true, attributeFilter: ["data-boot"] });
          setTimeout(done, 20000);
        }
      }

      // A key press anywhere outside a field is a shortcut. The footer lists
      // them, which is the only place they are written down.
      addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target;
        if (
          target instanceof HTMLElement &&
          (target.isContentEditable ||
            ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
        ) {
          return;
        }
        if (event.key === "t") {
          flip();
          return;
        }
        if (event.key === "p") {
          document.querySelector("#present")?.click();
          return;
        }
        const routes = { g: "generate/", e: "math/" };
        const route = routes[event.key];
        if (route) location.href = import.meta.env.BASE_URL + route;
      });
    </script>
  </body>
</html>
