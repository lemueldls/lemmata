{
  "name": "@lemmata/site",
  "private": true,
  "type": "module",
  "description": "The site: a specimen, a configurator and an equation bench.",
  "scripts": {
    "font": "node scripts/font.mjs",
    "font:write": "node scripts/font.mjs --write",
    "presets": "node scripts/presets.mjs",
    "presets:write": "node scripts/presets.mjs --write",
    "build": "nuxt generate",
    "build:workers": "NITRO_PRESET=cloudflare_module nuxt build",
    "dev": "nuxt dev",
    "preview": "pnpm build:workers && wrangler dev",
    "deploy": "pnpm build:workers && wrangler deploy",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.0.1",
    "lemmata-web": "workspace:*",
    "nuxt": "^4.6.2",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.3"
  }
}
