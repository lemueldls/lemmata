<!-- The equation corpus in MathML, the same constructs as equations.typ. The
     browser harness renders these with the built font and checks that it is the
     font that rendered them, which is what r[math.mathml] asks for. -->
<math display="block"><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mi>z</mi></math>
<math display="block"><mn>1</mn><mo>+</mo><mn>2</mn><mo>&#x2212;</mo><mn>3</mn><mo>&#x00D7;</mo><mn>4</mn></math>
<math display="block"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>=</mo><msup><mrow><mo>(</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo>)</mo></mrow><mn>2</mn></msup></math>
<math display="block"><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>=</mo><mfrac><mi>c</mi><mi>d</mi></mfrac></math>
<math display="block"><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></msqrt></math>
<math display="block"><munderover><mo>&#x2211;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mi>i</mi><mo>=</mo><mfrac><mrow><mi>n</mi><mo>(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>)</mo></mrow><mn>2</mn></mfrac></math>
<math display="block"><msubsup><mo>&#x222B;</mo><mn>0</mn><mn>1</mn></msubsup><msup><mi>x</mi><mn>2</mn></msup><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></math>
<math display="block"><mfrac><mrow><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo></mrow><mi>c</mi></mfrac><mo>&#x2264;</mo><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></msqrt></math>
<math display="block"><msqrt><mfrac><mn>1</mn><mn>2</mn></mfrac></msqrt></math>
<math display="block"><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></math>
<math display="block"><mi>&#x03B1;</mi><mo>+</mo><mi>&#x03B2;</mi><mo>=</mo><mi>&#x03B3;</mi></math>
<math display="block"><mrow><mo>(</mo><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>4</mn></mtd></mtr></mtable><mo>)</mo></mrow></math>
